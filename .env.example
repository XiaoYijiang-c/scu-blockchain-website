# Firebase config used by src/firebase.ts and src/React/LikeButton.tsx
# IMPORTANT: all of these must be prefixed with PUBLIC_ because Astro only
# exposes PUBLIC_-prefixed env vars to client-side (browser) code.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Server-only Sanity config. Do not add PUBLIC_ prefixes or use a write token.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Optional: viewer token for a private dataset. Leave empty for a public dataset.
SANITY_READ_TOKEN=
# HTTPS URL returned by `npm run cms:deploy`, e.g. your-project.sanity.studio.
SANITY_STUDIO_URL=
