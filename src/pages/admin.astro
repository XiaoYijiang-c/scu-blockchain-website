---
import AdminApp from "@/components/admin/AdminApp";
import { bindings } from "@/lib/admin/env";
import { authenticated, configured } from "@/lib/admin/auth";
import "../styles/globals.css";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/noto-sans-sc";
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
Astro.response.headers.set("X-Frame-Options", "DENY");
Astro.response.headers.set("Referrer-Policy", "same-origin");
let initialLoggedIn = false;
let setupError: string | undefined;
try {
  const env = bindings();
  if (!configured(env))
    setupError =
      "请按 docs/cms.md 配置管理员账号与密码。本地使用 .dev.vars，线上使用 Cloudflare Secrets。";
  else initialLoggedIn = await authenticated(Astro.request, env);
} catch {
  setupError = "数据库尚未就绪，请按 docs/cms.md 执行数据库初始化。";
}
if (setupError) Astro.response.status = 503;
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>内容管理 · 四川大学区块链协会</title>
    <link rel="icon" href="/favicon.png" />
  </head>
  <body class="min-w-80 bg-background px-4 text-foreground sm:px-8">
    <main>
      <AdminApp
        client:load
        initialLoggedIn={initialLoggedIn}
        setupError={setupError}
      />
    </main>
  </body>
</html>
<style is:global>
  html {
    color-scheme: dark;
    font-family: "Space Grotesk Variable", "Noto Sans SC Variable", sans-serif;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  :focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
