---
import ShowcaseCard from "@/components/ui/ShowcaseCard.astro";
interface Props {
  items: { title: string; text: string }[];
}
const { items } = Astro.props as Props;
---

<ol class="roadmap-steps" aria-label="发展规划方向">
  {items.map((item, index) => (
    <li>
      <ShowcaseCard
        class="roadmap-step"
        aria-labelledby={`roadmap-direction-${index}`}
      >
        <div class="roadmap-card-top" aria-hidden="true">
          <span class="gallery-index">
            DIRECTION / {String(index + 1).padStart(2, "0")}
          </span>
          <svg class="roadmap-emblem" viewBox="0 0 64 64" fill="none">
            <circle class="roadmap-orbit" cx="32" cy="32" r="25" />
            <circle
              class="roadmap-orbit roadmap-orbit-inner"
              cx="32"
              cy="32"
              r="16"
            />
            <path class="roadmap-spokes" d="M32 7v50M7 32h50" />
            <path
              class="roadmap-hub-mark"
              d="m32 23 8 5v9l-8 5-8-5v-9Zm-8 5 8 5 8-5m-8 5v9"
            />
            <g transform={`rotate(${index * 60} 32 32)`}>
              <circle class="roadmap-hub-dot" cx="32" cy="7" r="3" />
            </g>
          </svg>
        </div>
        <h3 id={`roadmap-direction-${index}`}>{item.title}</h3>
        <p>{item.text}</p>
        <span class="roadmap-card-line" aria-hidden="true"></span>
      </ShowcaseCard>
    </li>
  ))}
</ol>
