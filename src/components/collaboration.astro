---
import ShowcaseHeading from "@/components/ui/ShowcaseHeading.astro";
import ShowcaseCard from "@/components/ui/ShowcaseCard.astro";
import NetworkVisual from "@/components/NetworkVisual.astro";
const contributions = [
  "跨学科青年科创人才",
  "技术与投研科普内容产出",
  "校内科创活动落地",
  "西南高校社团联动渠道",
  "联合科研与赛事备赛共建",
];
const partners = [
  "高校科创社团",
  "科研机构",
  "技术团队",
  "科创平台",
  "赛事主办方",
  "技术社群",
];
---

<section
  id="partnership"
  class="showcase-section w-full border-t border-border"
  aria-labelledby="partnership-title"
>
  <div class="max-w-5xl mx-auto">
    <ShowcaseHeading
      id="partnership-title"
      kicker="BUILD TOGETHER"
      title="寻求合作 / 共建伙伴"
      intro="期待与高校、科研机构和技术社区携手，让跨学科想法连接真实问题与实践机会。"
    />
    <div class="partner-grid showcase-content">
      <ShowcaseCard class="partner-panel" data-motion-item>
        <div class="panel-caption">
          <span>WHAT WE BRING</span>
          <span aria-hidden="true">01 / ↗</span>
        </div>
        <h3>我方可提供</h3>
        <ul class="partner-list">
          {contributions.map((item, index) => (
            <li class="partner-row">
              <span class="partner-check" aria-hidden="true">
                0{index + 1}
              </span>
              <span>{item}</span>
              <span class="row-arrow" aria-hidden="true">
                ↗
              </span>
            </li>
          ))}
        </ul>
      </ShowcaseCard>
      <ShowcaseCard class="partner-panel partner-panel-accent" data-motion-item>
        <div class="panel-caption">
          <span>WHO WE HOPE TO MEET</span>
          <span aria-hidden="true">02 / ↙</span>
        </div>
        <h3>期望合作方</h3>
        <ul class="partner-tags">
          {partners.map((item) => (
            <li class="partner-tag">{item}</li>
          ))}
        </ul>
        <p class="panel-description">
          联合分享、科研探索、赛事备战与校园活动，都欢迎交流共建。
        </p>
        <a class="showcase-link" href="#join" data-magnetic>
          交流共建 <span aria-hidden="true">↗</span>
        </a>
      </ShowcaseCard>
    </div>
  </div>
</section>
<section
  id="alliance"
  class="showcase-section w-full border-t border-border"
  aria-labelledby="alliance-title"
>
  <div class="max-w-5xl mx-auto">
    <ShowcaseHeading
      id="alliance-title"
      kicker="SOUTHWEST UNIVERSITY NETWORK"
      title="西南高校区块链联盟"
      intro="倡议组建西南高校区块链联盟，连接川内高校相关科创社团，推动资源共享、跨校联合备赛与联合技术分享，共建西南青年科创生态。"
    />
    <ShowcaseCard class="alliance-panel showcase-content" data-motion-item>
      <div class="alliance-copy">
        <p class="panel-caption">OPEN INVITATION · 共建倡议</p>
        <div class="alliance-wordmark" aria-hidden="true">
          CONNECT<span>THE NEXT.</span>
        </div>
        <p class="panel-description">
          意向伙伴：电子科技大学、成都信息工程大学及川内各高校相关科创社团
        </p>
        <p class="showcase-note">
          以上为共建意向，不代表相关学校或社团已确认加入。
        </p>
        <a class="showcase-link" href="#join" data-magnetic>
          参与共建 <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="alliance-network" data-scroll-art aria-hidden="true">
        <NetworkVisual />
      </div>
    </ShowcaseCard>
  </div>
</section>
