---
const contributions = [
  "跨学科青年科创人才",
  "技术与投研科普内容产出",
  "校内科创活动落地",
  "西南高校社团联动渠道",
  "联合科研与赛事备赛共建",
];
const partners = ["高校科创社团", "科研机构", "技术团队", "科创平台", "赛事主办方", "技术社群"];
---

<section id="partnership" class="w-full py-14 md:py-20 border-t border-[#ffffff10]" aria-labelledby="partnership-title">
  <div class="max-w-5xl mx-auto">
    <p class="section-kicker">BUILD TOGETHER</p>
    <h2 id="partnership-title" class="section-title">寻求合作 <span class="text-[var(--white-icon)]">/ 共建伙伴</span></h2>
    <p class="section-intro">期待与高校、科研机构和技术社区携手，让跨学科想法连接真实问题与实践机会。</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <article class="partner-panel">
        <p class="text-sm tracking-[0.12em] text-[var(--sec)]">WHAT WE BRING</p>
        <h3 class="mt-3 text-2xl font-medium text-[var(--white)]">我方可提供</h3>
        <ul class="mt-6 space-y-3">
          {contributions.map((item) => <li class="partner-row"><span class="partner-check" aria-hidden="true">↗</span>{item}</li>)}
        </ul>
      </article>
      <article class="partner-panel partner-panel-accent">
        <p class="text-sm tracking-[0.12em] text-[var(--sec)]">WHO WE HOPE TO MEET</p>
        <h3 class="mt-3 text-2xl font-medium text-[var(--white)]">期望合作方</h3>
        <ul class="mt-6 flex flex-wrap gap-2">
          {partners.map((item) => <li class="partner-tag">{item}</li>)}
        </ul>
        <p class="mt-8 text-sm leading-relaxed text-[var(--white-icon)]">联合分享、科研探索、赛事备战与校园活动，都欢迎交流共建。</p>
      </article>
    </div>
  </div>
</section>

<section id="alliance" class="w-full py-14 md:py-20 border-t border-[#ffffff10]" aria-labelledby="alliance-title">
  <div class="max-w-5xl mx-auto">
    <p class="section-kicker">SOUTHWEST UNIVERSITY NETWORK</p>
    <div class="alliance-panel">
      <div class="max-w-3xl">
        <p class="text-sm tracking-[0.16em] text-[var(--sec)]">OPEN INVITATION · 共建倡议</p>
        <h2 id="alliance-title" class="mt-4 text-3xl md:text-5xl font-medium leading-tight text-[var(--white)]">西南高校区块链联盟</h2>
        <p class="mt-5 text-[var(--white-icon)] leading-relaxed md:text-lg">倡议组建西南高校区块链联盟，连接川内高校相关科创社团，推动资源共享、跨校联合备赛与联合技术分享，共建西南青年科创生态。</p>
        <p class="mt-6 text-sm text-[var(--white-icon)]">意向伙伴：电子科技大学、成都信息工程大学及川内各高校相关科创社团</p>
        <p class="mt-2 text-xs text-[var(--white-icon)]/70">以上为共建意向，不代表相关学校或社团已确认加入。</p>
      </div>
      <div class="alliance-mark" aria-hidden="true"><span>SW</span><i></i><b>BLOCKCHAIN</b></div>
    </div>
  </div>
</section>

<style is:global>
  .partner-panel {
    border: 1px solid var(--white-icon-tr);
    border-radius: 1.2rem;
    background: #1414149c;
    padding: clamp(1.25rem, 4vw, 2rem);
  }
  .partner-panel-accent { background: radial-gradient(ellipse at top right, #a476ff14, transparent 60%), #1414149c; }
  .partner-row { display: flex; align-items: flex-start; gap: 0.8rem; color: var(--white-icon); line-height: 1.6; }
  .partner-check { color: var(--sec); }
  .partner-tag { border: 1px solid var(--white-icon-tr); border-radius: 999px; padding: 0.55rem 0.85rem; color: var(--white-icon); font-size: 0.875rem; }
  .alliance-panel {
    position: relative;
    overflow: hidden;
    min-height: 320px;
    display: flex;
    align-items: center;
    border: 1px solid #a476ff40;
    border-radius: 1.5rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    background: radial-gradient(ellipse at 85% 50%, #a476ff20, transparent 38%), linear-gradient(135deg, #17151d, #111);
  }
  .alliance-mark { position: absolute; right: 4%; top: 50%; width: clamp(9rem, 25vw, 18rem); height: clamp(9rem, 25vw, 18rem); border: 1px solid #a476ff50; border-radius: 50%; display: grid; place-content: center; text-align: center; color: #a476ff80; transform: translateY(-50%); font-weight: 600; letter-spacing: 0.2em; }
  .alliance-mark::before, .alliance-mark::after { content: ""; position: absolute; inset: 12%; border: 1px solid #a476ff30; border-radius: 50%; }
  .alliance-mark::after { inset: 25%; }
  .alliance-mark span { font-size: clamp(2rem, 5vw, 4rem); }
  .alliance-mark i { height: 1px; width: 3rem; margin: 0.25rem auto; background: #a476ff80; }
  .alliance-mark b { font-size: 0.6rem; }
  @media (max-width: 767px) { .alliance-mark { opacity: 0.18; right: -8%; } }
</style>
