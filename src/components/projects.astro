---
const activities = [
  { number: "01", title: "从入门到实践", text: "技术沙龙与 Workshop，面向零基础同学开展系统学习。" },
  { number: "02", title: "项目底层拆解", text: "集体研读 DeFi 等标杆项目，理解协议机制与设计原理。" },
  { number: "03", title: "链上投研与复盘", text: "围绕链上生态开展研究，产出研报、案例分析与复盘。" },
  { number: "04", title: "论文研读与科研", text: "跟进前沿论文，围绕区块链与 AI-Agent 交叉方向探索课题。" },
  { number: "05", title: "组队科创赛事", text: "常态化组队参与黑客松、AI-Agent 及其他科创赛事。" },
  { number: "06", title: "连接开发者社群", text: "对接开发者社区，争取国内外赛事与技术交流机会。" },
];

const roadmap = [
  "搭建可传承的完整学习培养体系，持续沉淀资料库",
  "深耕区块链 × AI-Agent 前沿交叉领域",
  "稳定输出技术解析、研报与科研笔记",
  "常态化备赛，冲击各类科创赛事",
  "积极争取科创资助资源，支撑活动与对外交流",
  "建立长效运转机制，保障社团可持续传承",
];
---

<section id="activities" class="w-full py-14 md:py-20 border-t border-[#ffffff10]" aria-labelledby="activities-title">
  <div class="max-w-5xl mx-auto">
    <p class="section-kicker">LEARN · RESEARCH · BUILD</p>
    <h2 id="activities-title" class="section-title">我们在做什么</h2>
    <p class="section-intro">从基础学习到真实项目，从研究讨论到赛事协作，让想法在实践中生长。</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
      {activities.map((activity) => (
        <article class="info-card group">
          <span class="text-xs tracking-[0.2em] text-[var(--sec)]">{activity.number}</span>
          <h3 class="mt-5 text-xl font-semibold text-[var(--white)]">{activity.title}</h3>
          <p class="mt-3 leading-relaxed text-[var(--white-icon)]">{activity.text}</p>
          <span aria-hidden="true" class="mt-6 block h-px w-10 bg-[var(--sec)] transition-all group-hover:w-20"></span>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="roadmap" class="w-full py-14 md:py-20 border-t border-[#ffffff10]" aria-labelledby="roadmap-title">
  <div class="max-w-5xl mx-auto">
    <p class="section-kicker">GROW WITH PURPOSE</p>
    <h2 id="roadmap-title" class="section-title">发展规划</h2>
    <p class="section-intro">把短期活动沉淀为长期能力，让社团建设能够持续、协作、可传承。</p>
    <ol class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
      {roadmap.map((item, index) => (
        <li class="roadmap-item">
          <span class="roadmap-number">{String(index + 1).padStart(2, "0")}</span>
          <span class="leading-relaxed text-[var(--white)]">{item}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .section-kicker {
    color: var(--sec);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    margin-bottom: 0.65rem;
  }
  .section-title {
    color: var(--white);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .section-intro {
    color: var(--white-icon);
    line-height: 1.8;
    margin: 0.85rem 0 2rem;
    max-width: 42rem;
  }
  .info-card {
    background: linear-gradient(145deg, #171717, #111111);
    border: 1px solid var(--white-icon-tr);
    border-radius: 1.15rem;
    min-height: 190px;
    padding: 1.35rem;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .info-card:hover {
    border-color: #a476ff70;
    transform: translateY(-3px);
  }
  .roadmap-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border: 1px solid var(--white-icon-tr);
    border-radius: 0.9rem;
    background: #1414149c;
    padding: 1.1rem;
  }
  .roadmap-number {
    color: var(--sec);
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    padding-top: 0.15rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .info-card { transition: none; }
    .info-card:hover { transform: none; }
  }
</style>
