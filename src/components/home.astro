---
import badgeSvg from "../../public/logo/0xwe-badge.svg?raw";
const directions = ["区块链", "智能合约", "Web3", "AI-Agent"];
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow" data-reveal>
        <span></span>四川大学区块链协会
      </p>
      <h1 id="hero-title" data-reveal>
        让好奇心
        <br />
        <span class="hero-gradient">连接未来。</span>
      </h1>
      <p class="hero-description" data-reveal>
        四川大学跨专业科创学术社团。聚焦区块链、智能合约、Web3 与 AI-Agent
        交叉方向，打造西南高校青年技术交流平台，欢迎所有保有好奇心的同学。
      </p>
      <div class="hero-actions" data-reveal>
        <a href="#join" class="button-primary">
          加入我们 <span aria-hidden="true">↗</span>
        </a>
        <a href="#activities" class="button-secondary">
          探索社团 <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="hero-caption" data-reveal>
        STUDENT-LED. CURIOSITY-DRIVEN.
      </p>
    </div>
    <div class="hero-art">
      <div class="badge-stage" data-pointer-tilt="badge" role="group" tabindex="0" aria-label="可交互的区块链协会 3D 徽章。移动鼠标调整角度，按住拖动旋转，也可使用方向键。">
        <div class="badge-medallion" role="img" aria-label="四川大学区块链协会 0xWE 徽章" set:html={badgeSvg} />
      </div>
    </div>
  </div>
  <div class="direction-strip" aria-label="关注领域">
    <span class="direction-caption">
      探索交叉领域 <span aria-hidden="true">↘</span>
    </span>
    {directions.map((direction, index) => (
      <div class="direction-item">
        <span>0{index + 1}</span>
        {direction}
      </div>
    ))}
  </div>
</section>
