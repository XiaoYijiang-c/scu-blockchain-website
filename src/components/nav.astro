---
interface NavItem {
  label: string;
  href: string;
  icon: string;
  sections?: string[];
}

const navItems: NavItem[] = [
  {
    label: "关于",
    href: "#home",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-6h2v6Zm0-8h-2V7h2v2Z"/></svg>`,
  },
  {
    label: "活动",
    href: "#activities",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 16H5V9h14v11Z"/></svg>`,
  },
  {
    label: "规划",
    href: "#roadmap",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M3 3h2v18H3V3Zm4 1h13l-2 4 2 4H7V4Zm0 10h13l-2 3 2 3H7v-6Z"/></svg>`,
  },
  {
    label: "合作",
    href: "#partnership",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M16 11a4 4 0 1 0-3.46-6 5 5 0 0 1 0 8A4 4 0 0 0 16 11ZM8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-3.33 0-6 1.67-6 3.5V20h12v-2.5C14 15.67 11.33 14 8 14Zm8 .1c-.42 0-.88.03-1.35.09A5.2 5.2 0 0 1 16 17.5V20h6v-2.5c0-1.83-2.67-3.4-6-3.4Z"/></svg>`,
  },
  {
    label: "共建",
    href: "#alliance",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M16 11a4 4 0 1 0-3.46-6 5 5 0 0 1 0 8A4 4 0 0 0 16 11ZM8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-3.33 0-6 1.67-6 3.5V20h12v-2.5C14 15.67 11.33 14 8 14Zm8 .1c-.42 0-.88.03-1.35.09A5.2 5.2 0 0 1 16 17.5V20h6v-2.5c0-1.83-2.67-3.4-6-3.4Z"/></svg>`,
  },
  {
    label: "回顾",
    href: "#archive",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M3 4h18v4H3V4Zm2 6h14v10H5V10Zm4 2v2h6v-2H9Z"/></svg>`,
  },
  {
    label: "资源",
    href: "#resources",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm2 4v2h10V7H7Zm0 4v2h10v-2H7Zm0 4v2h7v-2H7Z"/></svg>`,
  },
  {
    label: "加入",
    href: "#join",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2Z"/></svg>`,
  },
];

const navGroups: NavItem[] = [
  { label: "关于", href: "#home", icon: navItems[0].icon, sections: ["home", "members"] },
  { label: "学习与实践", href: "#activities", icon: navItems[1].icon, sections: ["activities", "roadmap", "archive", "resources"] },
  { label: "合作共建", href: "#partnership", icon: navItems[3].icon, sections: ["partnership", "alliance"] },
  { label: "加入我们", href: "#join", icon: navItems[7].icon, sections: ["join"] },
];
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    aria-label="主导航"
    class="fixed left-1/2 -translate-x-1/2 z-[100] bg-[var(--background)] border border-1 border-transparent backdrop-blur-xl transition-all duration-500 ease-in-out md:top-6 md:bottom-auto bottom-0 w-[80%]"
  >
    <div class="container mx-auto flex justify-center items-center p-3">
      <ul class="flex w-full justify-between md:space-x-6 md:justify-center md:gap-12 gap-2 max-md:w-max max-md:min-w-full max-md:px-4">
        {navGroups.map((item) => (
          <li class="flex-1 md:flex-none max-md:flex-none">
            <a
              href={item.href}
              data-sections={item.sections?.join(" ")}
              aria-current={
                item.href === (Astro.url.hash || "#home")
                  ? "location"
                  : undefined
              }
              class="flex flex-col items-center gap-1 text-[var(--white-icon)] transition-colors text-xs md:text-base relative group rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--sec)]"
            >
              <span class="absolute -left-6 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full transition-all duration-300 scale-0 opacity-0 bg-[var(--sec)] nav-indicator hidden md:block" />
              <span
                class="md:hidden flex items-center justify-center w-6 h-6"
                set:html={item.icon}
              />
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</div>

<style>
  nav {
    background-color: var(--background);
    transition:
      background-color 0.3s ease,
      border-radius 0.3s ease,
      border-color 0.3s ease;
  }

  nav.scrolling {
    background-color: var(--component-bg);
    border-color: var(--border-subtle);
    border-radius: 9999px;
  }

  nav a.active .nav-indicator {
    transform: translateY(-50%) scale(1);
    opacity: 1;
  }

  nav a.active {
    color: var(--white) !important;
  }

  @media (max-width: 767px) {
    nav {
      width: 100% !important;
      bottom: 0;
      left: 50%;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      border-radius: 1rem 1rem 0 0;
      border-color: var(--border-subtle);
      padding-bottom: env(safe-area-inset-bottom);
    }

    nav::-webkit-scrollbar {
      display: none;
    }

    nav li {
      flex: 0 0 auto;
      min-width: 3.25rem;
    }

    nav.scrolling {
      border-radius: 1rem 1rem 0 0;
      background-color: var(--component-bg);
    }

    :global(body) {
      padding-bottom: calc(84px + env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>('#main-nav a[href^="#"]'),
  ];
  const sections = [
    ...document.querySelectorAll<HTMLElement>("main section[id]"),
  ];
  const preference = window.matchMedia("(prefers-reduced-motion: reduce)");
  let frame = 0;
  function update() {
    frame = 0;
    nav?.classList.toggle("scrolling", window.scrollY > 8);
    // A stable reading line works for both full-screen and taller sections.
    const readingLine = Math.min(window.innerHeight * 0.3, 200);
    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= readingLine) current = section;
    }
    if (!current) return;
    links.forEach((link) => {
      const active = link.dataset.sections?.split(" ").includes(current.id) ?? link.hash === `#${current.id}`;
      link.classList.toggle("active", active);
      if (active) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  }
  function scheduleUpdate() {
    if (!frame) frame = requestAnimationFrame(update);
  }
  window.addEventListener("scroll", scheduleUpdate, { passive: true });
  window.addEventListener("resize", scheduleUpdate);
  document
    .querySelectorAll<HTMLAnchorElement>('a[href^="#"]')
    .forEach((anchor) => {
      anchor.addEventListener("click", (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        const target = document.getElementById(anchor.hash.slice(1));
        if (!target) return;
        event.preventDefault();
        if (location.hash !== anchor.hash)
          history.pushState(null, "", anchor.hash);
        // Keep keyboard navigation at the destination without a second scroll.
        if (!target.hasAttribute("tabindex"))
          target.setAttribute("tabindex", "-1");
        target.focus({ preventScroll: true });
        target.scrollIntoView({
          behavior: preference.matches ? "instant" : "smooth",
          block: "start",
        });
      });
    });
  update();
</script>
