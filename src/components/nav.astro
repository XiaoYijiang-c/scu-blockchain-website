---
import {
  House,
  CalendarDays,
  Users,
  Flag,
  Archive,
  BookOpen,
  Handshake,
  Network,
  Plus,
} from "lucide-react";

const navItems = [
  { label: "关于", title: "首页 / 关于我们", href: "#home", icon: House },
  {
    label: "活动",
    title: "我们在做什么",
    href: "#activities",
    icon: CalendarDays,
  },
  { label: "成员", title: "认识我们的成员", href: "#members", icon: Users },
  { label: "规划", title: "发展规划", href: "#roadmap", icon: Flag },
  { label: "回顾", title: "活动回顾", href: "#archive", icon: Archive },
  { label: "资源", title: "学习资源中心", href: "#resources", icon: BookOpen },
  {
    label: "合作",
    title: "寻求合作 / 共建伙伴",
    href: "#partnership",
    icon: Handshake,
  },
  {
    label: "联盟",
    title: "西南高校区块链联盟",
    href: "#alliance",
    icon: Network,
  },
  { label: "加入", title: "加入我们 / 联系", href: "#join", icon: Plus },
];
---

<nav id="main-nav" aria-label="主导航">
  <div class="nav-scroll">
    <ul>
      {navItems.map((item) => {
        const Icon = item.icon;
        return (
          <li>
            <a
              href={item.href}
              aria-label={item.title}
              title={item.title}
              aria-current={item.href === "#home" ? "location" : undefined}
            >
              <span class="nav-icon" aria-hidden="true">
                <Icon size={20} strokeWidth={1.7} />
              </span>
              <span>{item.label}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<style>
  @media (max-width: 767px) {
    :global(body) {
      padding-bottom: calc(84px + env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const scroller = nav?.querySelector<HTMLElement>(".nav-scroll");
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>('#main-nav a[href^="#"]'),
  ];
  const sections = [
    ...document.querySelectorAll<HTMLElement>("main section[id]"),
  ];
  const preference = window.matchMedia("(prefers-reduced-motion: reduce)");
  let frame = 0;
  let currentLink: HTMLAnchorElement | undefined;
  function update() {
    frame = 0;
    nav?.classList.toggle("scrolling", window.scrollY > 8);
    const readingLine = Math.min(window.innerHeight * 0.3, 200);
    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= readingLine) current = section;
    }
    if (!current) return;
    links.forEach((link) => {
      const active = link.hash === `#${current.id}`;
      link.classList.toggle("active", active);
      if (active) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
      if (active && currentLink !== link) {
        currentLink = link;
        if (scroller && scroller.scrollWidth > scroller.clientWidth) {
          const linkRect = link.getBoundingClientRect();
          const box = scroller.getBoundingClientRect();
          scroller.scrollTo({
            left:
              scroller.scrollLeft +
              linkRect.left -
              box.left -
              (box.width - linkRect.width) / 2,
            behavior: preference.matches ? "instant" : "smooth",
          });
        }
      }
    });
  }
  function scheduleUpdate() {
    if (!frame) frame = requestAnimationFrame(update);
  }
  window.addEventListener("scroll", scheduleUpdate, { passive: true });
  window.addEventListener("resize", () => {
    currentLink = undefined;
    scheduleUpdate();
  });
  document
    .querySelectorAll<HTMLAnchorElement>('a[href^="#"]')
    .forEach((anchor) => {
      anchor.addEventListener("click", (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        const target = document.getElementById(anchor.hash.slice(1));
        if (!target) return;
        event.preventDefault();
        if (location.hash !== anchor.hash)
          history.pushState(null, "", anchor.hash);
        if (!target.hasAttribute("tabindex"))
          target.setAttribute("tabindex", "-1");
        target.focus({ preventScroll: true });
        target.scrollIntoView({
          behavior: preference.matches ? "instant" : "smooth",
          block: "start",
        });
      });
    });
  update();
</script>
