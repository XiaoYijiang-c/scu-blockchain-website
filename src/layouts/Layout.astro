---
import "../styles/design.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const siteName = "四川大学区块链协会";
const description =
  "川大跨专业科创学术社团，聚焦区块链、智能合约、Web3 与 AI-Agent 交叉方向，打造西南高校青年技术交流平台。";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <title>{title === siteName ? title : `${title} | ${siteName}`}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101010" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content="/og.image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "四川大学区块链协会",
        "description": "川大跨专业科创学术社团，关注区块链与 AI-Agent 交叉创新。"
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-10 lg:px-20 px-5 md:px-12">
    <slot />
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #09090d;
    --component-bg: #171717ef;
    --sec: #b69aff;
    --white: #f0eff5;
    --white-icon: #a4a3b3;
    --white-icon-tr: #f3f3f310;
    color-scheme: dark;
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  * {
    font-family:
      "Montserrat Variable",
      "PingFang SC",
      "Microsoft YaHei",
      "Noto Sans CJK SC",
      -apple-system,
      system-ui,
      sans-serif;
  }
  html {
    background: var(--background);
  }
  body {
    min-width: 320px;
    color: var(--white);
    overflow-x: clip;
  }
  ::selection {
    background-color: var(--sec);
    color: var(--background);
  }
  a {
    -webkit-tap-highlight-color: transparent;
  }
  :focus-visible {
    outline: 2px solid var(--sec);
    outline-offset: 4px;
  }
  .skip-link {
    position: fixed;
    left: 1rem;
    top: 1rem;
    z-index: 200;
    transform: translateY(-200%);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--sec);
    color: #15111f;
    font-weight: 600;
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  section[id] {
    scroll-margin-top: 6rem;
  }

  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: var(--background);
  }
  ::-webkit-scrollbar-thumb {
    background: #39313f;
    border: 2px solid var(--background);
    border-radius: 20px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }
  * {
    scrollbar-width: thin;
    scrollbar-color: #39313f var(--background);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
